{
  "name": "girlyanda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/dev.mjs",
    "build": "ng build",
    "serve:mail": "node --env-file-if-exists=.env server/index.mjs",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "lint": "npm run lint:code && npm run lint:styles",
    "lint:fix": "npm run lint:code -- --fix && npm run lint:styles -- --fix",
    "lint:code": "eslint . --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.scss\" --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run tests/catalog.test.ts tests/mail.test.mjs",
    "e2e": "playwright test"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/platform-server": "22.3.0",
    "@angular/router": "22.3.0",
    "@angular/ssr": "22.3.0",
    "@fontsource-variable/golos-text": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "express": "5.3.0",
    "nodemailer": "10.6.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "22.20.7",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "postcss-scss": "4.0.9",
    "prettier": "3.10.1",
    "stylelint": "18.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.1",
    "wrangler": "4.158.0"
  }
}
