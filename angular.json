{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  },
  "projects": {
    "girlyanda": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "LICENSE",
                "input": "node_modules/@fontsource-variable/manrope",
                "output": "licenses/manrope"
              },
              {
                "glob": "LICENSE",
                "input": "node_modules/@fontsource-variable/golos-text",
                "output": "licenses/golos-text"
              }
            ],
            "styles": ["src/styles.scss"],
            "server": "src/main.server.ts",
            "outputMode": "static"
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "350kb",
                  "maximumError": "500kb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "girlyanda:build:development",
              "proxyConfig": "server/proxy.conf.json"
            },
            "production": {
              "buildTarget": "girlyanda:build:production"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
